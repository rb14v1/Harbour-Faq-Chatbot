# Copy to .env and fill in real values before running docker compose.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Database (Postgres + pgvector) ---
POSTGRES_DB=faq_chatbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# DEV-ONLY: set USE_SQLITE=True to run manage.py commands (check,
# makemigrations, test) against local SQLite when Docker/Postgres/pgvector
# aren't available, e.g. on a bare dev machine. Never set this in
# docker-compose/production. See backend/config/settings/base.py and
# backend/apps/common/embedding_field.py.
USE_SQLITE=False

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI (OpenAI) ---
# Leave OPENAI_API_KEY unset to run entirely on deterministic stubs (no
# network access, no cost). Set it to enable real embeddings/chat answers.
# See backend/apps/common/ai.py.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-5.6-sol
ASK_TOP_K=3

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api
